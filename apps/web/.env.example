# Public origin for server-side self-fetch (src/hooks/use-*/server.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:9000

# Prisma — used by src/app/api/{blog,pricing,testimonials}/route.ts
# Prefer the pooled URL (port 6543, ?pgbouncer=true) for DATABASE_URL in production.
# See packages/db/.env.example.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase (unused by this app today — no auth or Supabase client)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
