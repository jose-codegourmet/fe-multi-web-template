# Supabase (browser)
# apps/web does not query Supabase or Prisma yet — these are here for when it does.
# Copy to .env.local and fill in your own values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# If this app starts querying Prisma directly, also add DATABASE_URL / DIRECT_URL
# (see packages/db/.env.example — prefer the pooled URL on port 6543 for DATABASE_URL).
